{
    "name": "praemunio/sdk",
    "description": "PHP client for the Praemunio public API",
    "keywords": [
        "praemunio",
        "api",
        "sdk",
        "openapi",
        "php",
        "rest"
    ],
    "homepage": "https://docs.praemunio.org",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Praemunio",
            "homepage": "https://praemunio.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3 || ^8.0",
        "guzzlehttp/psr7": "^1.7 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "OpenAPI\\Client\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "OpenAPI\\Client\\Test\\" : "test/" }
    }
}
